   "source": [
    "import joblib\n",
    "import pandas as pd\n",
    "model=joblib.load('Sp.pkl')\n",
    "\n",
    "val=float(input(\"Enter year of experience: \"))\n",
    "data=pd.DataFrame({\n",
    "    'YearsExperience':[val]\n",
    "})\n",
    "\n",
    "predicted=model.predict(data)\n",
    "print(\"predicted salary: \",predicted[0])\n"
   ]
  },
